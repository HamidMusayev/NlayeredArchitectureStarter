<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <CodeAnalysisRuleSet>../settings.ruleset</CodeAnalysisRuleSet>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerComposeProjectPath>../docker-compose.dcproj</DockerComposeProjectPath>
        <UserSecretsId>013ba4ca-2abe-4967-a3e4-d951a0a82573</UserSecretsId>
        <LangVersion>default</LangVersion>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(RunConfiguration)' == 'API - Production' "/>
    <PropertyGroup Condition=" '$(RunConfiguration)' == 'API - Development' "/>
    <ItemGroup>
        <Compile Remove="wwwroot\users\**"/>
        <Content Remove="wwwroot\users\**"/>
        <EmbeddedResource Remove="wwwroot\users\**"/>
        <None Remove="wwwroot\users\**"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0"/>
        <PackageReference Include="GraphQL.Server.Transports.AspNetCore" Version="8.3.3"/>
        <PackageReference Include="GraphQL.Server.Ui.Voyager" Version="8.3.3"/>
        <PackageReference Include="Hangfire" Version="1.8.22"/>
        <PackageReference Include="Hangfire.PostgreSql" Version="1.20.13"/>
        <PackageReference Include="HotChocolate.Abstractions" Version="15.1.11"/>
        <PackageReference Include="HotChocolate.AspNetCore" Version="15.1.11"/>
        <PackageReference Include="HotChocolate.Data.EntityFramework" Version="15.1.11"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1"/>
        <PackageReference Include="MiniProfiler.EntityFrameworkCore" Version="4.5.4"/>
        <PackageReference Include="MongoDB.Driver" Version="3.5.2"/>
        <PackageReference Include="Nummy.CodeLogger" Version="2.1.0"/>
        <PackageReference Include="Nummy.ExceptionHandler" Version="2.1.0"/>
        <PackageReference Include="Nummy.HealthChecker" Version="2.1.0"/>
        <PackageReference Include="Nummy.HttpLogger" Version="2.1.0"/>
        <PackageReference Include="Redis.OM" Version="1.1.0"/>
        <PackageReference Include="Refit" Version="9.0.2"/>
        <PackageReference Include="Refit.HttpClientFactory" Version="9.0.2"/>
        <PackageReference Include="Scrutor" Version="7.0.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.1.0" />
        <PackageReference Include="MiniProfiler.AspNetCore.Mvc" Version="4.5.4"/>
        <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Microsoft.EntityFrameworkCore.Design"/>
        <None Remove="Swashbuckle.AspNetCore.Annotations"/>
        <None Remove="Controllers\"/>
        <None Remove="MiniProfiler.AspNetCore.Mvc"/>
        <None Remove="FluentValidation.AspNetCore"/>
        <None Remove="Middlewares\"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BLL\BLL.csproj">
            <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        </ProjectReference>
        <ProjectReference Include="..\CORE\CORE.csproj">
            <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        </ProjectReference>
        <ProjectReference Include="..\DTO\DTO.csproj">
            <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        </ProjectReference>
        <ProjectReference Include="..\MEDIATRS\MEDIATRS.csproj"/>
        <ProjectReference Include="..\REFITS\REFITS.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Content Remove="wwwroot\files\**"/>
    </ItemGroup>
</Project>
